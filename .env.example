# Copy to .env and replace N8N_ENCRYPTION_KEY.
# Generate a key: openssl rand -hex 32
#
# Mac defaults below. On a VPS, change N8N_BIND_HOST, N8N_HOST,
# N8N_EDITOR_BASE_URL, and WEBHOOK_URL. Do not commit .env.

N8N_BIND_HOST=127.0.0.1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Rome
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
N8N_SECURE_COOKIE=false
