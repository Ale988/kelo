    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-sender",
              "leftValue": "={{ String($json.senders || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean).some(s => String($json.from || '').toLowerCase().includes(s)) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-subject",
              "leftValue": "={{ (() => { const keys = String($json.subjectKeywords || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean); const subject = String($json.subject || '').toLowerCase(); return keys.length === 0 || keys.some(k => subject.includes(k)); })() }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
