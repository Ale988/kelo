      "id": "allowlists-edit-fields",
      "name": "Allowlists",
      "notes": "senders: exact email or @domain. subjectKeywords: substring, optional."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function extractEmail(fromHeader) {\n  const raw = String(fromHeader || '');\n  const angle = raw.match(/<([^>]+)>/);\n  const candidate = (angle ? angle[1] : raw).trim().toLowerCase();\n  // Keep only a bare address if the header is messy\n  const email = candidate.match(/[^\\s<>]+@[^\\s<>]+/);\n  return email ? email[0] : candidate;\n}\n\nfunction senderMatches(fromHeader, entry) {\n  const needle = String(entry || '').trim().toLowerCase();\n  if (!needle) return false;\n  const fromEmail = extractEmail(fromHeader);\n  // Domain allowlist: \"@octopusenergy.it\"\n  if (needle.startsWith('@')) {\n    return fromEmail.endsWith(needle);\n  }\n  // Exact address match (avoids \"an@\" matching \"evan@\")\n  return fromEmail === needle;\n}\n\nconst senders = String($json.senders || '')\n  .split(',')\n  .map((s) => s.trim())\n  .filter(Boolean);\n$json.matchedSender = senders.some((s) => senderMatches($json.from, s));\n\nconst keywords = String($json.subjectKeywords || '')\n  .split(',')\n  .map((s) => s.trim().toLowerCase())\n  .filter(Boolean);\nconst subject = String($json.subject || '').toLowerCase();\n$json.matchedSubject =\n  keywords.length === 0 || keywords.some((k) => subject.includes(k));\n\nconst binary = $binary || {};\n$json.hasPdf = Object.values(binary).some((b) => {\n  const mime = String(b.mimeType || '').toLowerCase();\n  const ext = String(b.fileExtension || '').toLowerCase();\n  const name = String(b.fileName || '').toLowerCase();\n  return mime.includes('pdf') || ext === 'pdf' || name.endsWith('.pdf');\n});\n\nconst metadata = $json.metadata || {};\nconst headerId = String(\n  metadata['message-id'] || metadata['Message-ID'] || metadata.messageId || '',\n).trim();\nconst uid = $json.attributes?.uid;\n$json.messageId = headerId || (uid != null ? `uid:${uid}` : '');\n\nreturn $input.item;\n"
      },
